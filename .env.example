# SonarCloud (obligatoire pour /qg et le wrap /implement). Project key = org_repo, ex. UlyssouLV_ArgOS.
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=
SONAR_PROJECT_KEY=UlyssouLV_ArgOS

# IP de cette machine sur le réseau local (ex. 192.168.1.20), plusieurs séparées par des virgules : WebRTC du
# Live, et noms du certificat serveur du Site (avec localhost et 127.0.0.1).
# Vide : le Site n'est joignable en HTTPS valide, et le Live en WebRTC, que depuis cette machine.
MTX_WEBRTCADDITIONALHOSTS=

# Ports publiés par le Site (facultatifs) : HTTPS (UI, API, Live), et deux ports HTTP qui redirigent vers HTTPS
# et servent la partie publique de l'Autorité du Site (/argos-ca.crt). 8080 : ancienne adresse de l'UI.
ARGOS_PORT_HTTPS=443
ARGOS_PORT_HTTP=80
ARGOS_PORT_HTTP_ANCIEN=8080

# Certificat de l'Administrateur (facultatif : nom de domaine, VPN avec certificats), à la place de l'Autorité du
# Site : dossier (absolu, ou relatif à ce dépôt) qui contient certificat.crt (le certificat, chaîne comprise) et
# cle.key (sa clé, non chiffrée). Servis tels quels : ArgOS ne les renouvelle pas, et /argos-ca.crt répond 404.
# Fichier manquant : le Site ne démarre pas. Vide : Autorité du Site et certificat serveur générés par ArgOS.
ARGOS_CERTIFICAT_DOSSIER=

# Compte de l'Administrateur de l'API du Site (obligatoires). Choisir un mot de passe long
# (une phrase de plusieurs mots, ou : python3 -c 'import secrets; print(secrets.token_urlsafe(24))').
ARGOS_IDENTIFIANT=
ARGOS_MOT_DE_PASSE=

# Sonde de l'état des Caméras actives (secondes, facultatifs) : intervalle entre deux sondes et
# délai pour recevoir un premier paquet vidéo avant de déclarer la Caméra offline.
ARGOS_SONDE_INTERVALLE_S=10
ARGOS_SONDE_DELAI_S=5

# Ajout d'une Caméra (facultatif) : l'Aperçu, renouvelé par l'UI tant que le panneau est ouvert, est retiré
# après ce délai sans renouvellement (onglet fermé), en secondes.
ARGOS_APERCU_EXPIRATION_S=120

# Détection des Caméras (Administration). Le script scripts/cameras/configurer-detection.sh, lancé sur
# la machine hôte (lancer-argos.command l'appelle), demande une fois la ou les prises réseau qui relient
# les caméras et les retient dans ARGOS_DETECTION_CAMERAS_INTERFACES (ex. eth1, ou eth1,eth2), puis
# recalcule à chaque lancement leurs sous-réseaux dans ARGOS_DETECTION_CAMERAS_SOUS_RESEAUX.
# Prises : vide = le script les liste et demande au prochain lancement en terminal.
ARGOS_DETECTION_CAMERAS_INTERFACES=
# Sous-réseaux IPv4 où chercher, en notation CIDR, séparés par des virgules (ex. 192.168.1.0/24),
# 1024 adresses au plus en tout. Écrits par le script ; sans le script, à écrire à la main.
# Vide, invalide ou au-delà du plafond : seule la Détection est indisponible (avec la raison), le reste d'ArgOS marche.
ARGOS_DETECTION_CAMERAS_SOUS_RESEAUX=
# Ports sondés sur chaque adresse, séparés par des virgules.
ARGOS_DETECTION_CAMERAS_PORTS=554,8554

# Réseau des caméras (prod Linux seulement, docs/adr/0003-macvlan-sur-la-prise-des-cameras.md) : l'API rejoint
# par macvlan la première prise des caméras, pour y lire leurs MAC, sans y être joignable. Écrits par le script
# ci-dessus, qui ajoute compose.reseau-cameras.yaml à COMPOSE_FILE ; jamais sous macOS (Docker Desktop).
# IP fixe d'ArgOS sur ce réseau, hors de la plage DHCP : proposée (libre en ARP) au premier lancement en terminal.
ARGOS_RESEAU_CAMERAS_IP=
# Prise et sous-réseau du réseau des caméras, recalculés à chaque lancement.
ARGOS_RESEAU_CAMERAS_PRISE=
ARGOS_RESEAU_CAMERAS_SOUS_RESEAU=
