SONAR_HOST_URL=
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# WebRTC sur le réseau local : IP de cette machine (ex. 192.168.1.20), plusieurs séparées par des virgules.
# Vide : WebRTC seulement depuis cette machine (http://localhost:8889/camN).
MTX_WEBRTCADDITIONALHOSTS=

# Compte de l'Administrateur de l'API du Site (obligatoires). Choisir un mot de passe long
# (une phrase de plusieurs mots, ou : python3 -c 'import secrets; print(secrets.token_urlsafe(24))').
ARGOS_IDENTIFIANT=
ARGOS_MOT_DE_PASSE=

# Sonde de l'état des Caméras actives (secondes, facultatifs) : intervalle entre deux sondes et
# délai pour recevoir un premier paquet vidéo avant de déclarer la Caméra offline.
ARGOS_SONDE_INTERVALLE_S=10
ARGOS_SONDE_DELAI_S=5
