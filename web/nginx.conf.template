# Une seule origine HTTPS (docs/adr/0005-https-par-une-origine-unique-et-une-autorite-du-site.md) : l'UI, l'API
# et le Live (WHEP, HLS) sous la même adresse. Gabarit : ${ARGOS_PORT_HTTPS} est remplacé au démarrage de web.
# Certificat serveur et partie publique de l'Autorité du Site : volume écrit par le service certificats.

# Noms Compose résolus à chaque requête : api et mediamtx peuvent redémarrer (et changer d'IP) sans web.
resolver 127.0.0.11 valid=10s ipv6=off;

# Port HTTPS publié sur l'hôte : absent des redirections quand c'est le port par défaut.
map "${ARGOS_PORT_HTTPS}" $suffixe_port_https {
    "443"   "";
    default ":${ARGOS_PORT_HTTPS}";
}

# HTTP (ports 80 et 8080 de l'hôte) : seulement la partie publique de l'Autorité, le reste redirigé en HTTPS.
server {
    listen 8080;

    include /etc/nginx/argos-ca.conf;

    location / {
        return 301 https://$host$suffixe_port_https$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/nginx/certificats/serveur.crt;
    ssl_certificate_key /etc/nginx/certificats/serveur.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html;
    # Redirections relatives : justes quel que soit le port HTTPS publié.
    absolute_redirect off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Routes du front (/connexion, /administration, /live) : servies par index.html.
    location / {
        try_files $uri /index.html;
    }

    include /etc/nginx/argos-ca.conf;

    location /api/ {
        set $api http://api:8000;
        proxy_pass $api;
    }

    # Flux réservés à une session ArgOS (docs/adr/0006-flux-authentifies-par-nginx.md) : chaque requête /flux/ est
    # d'abord vérifiée par l'API avec le cookie du navigateur ; sans session valide, 401 et rien n'est relayé.
    location = /_session-des-flux {
        internal;
        set $api http://api:8000;
        proxy_pass $api/api/session;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # WHEP : /flux/webrtc/<chemin>/whep (offre SDP), puis PATCH et DELETE sur la session qu'il renvoie.
    location /flux/webrtc/ {
        auth_request /_session-des-flux;
        set $webrtc http://mediamtx:8889;
        rewrite ^/flux/webrtc(/.*)$ $1 break;
        proxy_pass $webrtc;
        proxy_redirect ~^(/.*)$ /flux/webrtc$1;
    }

    # LL-HLS : /flux/hls/<chemin>/index.m3u8, ses variantes et segments, sans mise en tampon.
    location /flux/hls/ {
        auth_request /_session-des-flux;
        set $hls http://mediamtx:8888;
        rewrite ^/flux/hls(/.*)$ $1 break;
        proxy_pass $hls;
        proxy_redirect ~^(/.*)$ /flux/hls$1;
        proxy_buffering off;
    }
}
